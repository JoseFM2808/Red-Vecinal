# ---------------------------------------------------------------------------
# Vecino Seguro — contratos (proyecto Hardhat, aislado del frontend Next.js)
#
# Copiar a .env (NUNCA a .env.example) y llenar antes de desplegar de verdad.
# Este archivo es solo para desplegar/verificar contratos — no tiene relacion
# con .env.local del frontend en la raiz del repo.
# ---------------------------------------------------------------------------

# Clave privada del wallet que despliega. SECRETO — nunca la de un wallet con fondos reales
# para el hackathon, y nunca commitear el .env real (ya esta en .gitignore).
# Formato: con o sin el prefijo 0x.
DEPLOYER_PRIVATE_KEY=

# RPC de Arbitrum Sepolia. Default sugerido (el mismo que usa el frontend en
# src/lib/chain/redes.ts): https://sepolia-rollup.arbitrum.io/rpc
# Usar uno propio (Alchemy/Infura/etc.) si el publico da rate-limit durante el despliegue.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# RPC de Arbitrum One, solo si se despliega a produccion.
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# Para verificar el codigo fuente en Arbiscan despues de desplegar (opcional pero
# recomendado: sin esto el contrato es una caja negra para el jurado).
ARBISCAN_API_KEY=
