# ---------------------------------------------------------------------------
# Vecino Seguro — variables de entorno
#
# Local:  copiar a .env.local
# Vercel: Project Settings > Environment Variables
#
# La beta funciona SIN ninguna de estas variables (modo simulado por defecto).
#
# IMPORTANTE — las variables NEXT_PUBLIC_* se incrustan en el JavaScript del
# navegador durante el BUILD. Dos consecuencias:
#   1. Cambiarlas en el panel de Vercel NO afecta a un deploy ya publicado.
#      Hay que hacer Redeploy.
#   2. Su valor es PUBLICO. Nunca poner un secreto con ese prefijo.
#      `npm run preflight` aborta el build si detecta uno.
# ---------------------------------------------------------------------------

# --- Login con Google (opcional) -------------------------------------------
# Sin estas tres, el boton de acceso no se muestra y todos usan su seudonimo local.
# El login NO identifica al vecino ante la red: solo sirve para recuperar el mismo
# alias en otro telefono. Ver docs/DESPLIEGUE.md, seccion "Login con Google".
#
# Clave para firmar la cookie de sesion. Generar con: npx auth secret
# SECRETO. Obligatoria si defines las dos de abajo (el preflight aborta el build sin ella).
AUTH_SECRET=

# Credenciales de Google Cloud Console > APIs y servicios > Credenciales.
# AUTH_GOOGLE_SECRET es SECRETO. Ninguna de las dos lleva prefijo NEXT_PUBLIC_.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Cadena ----------------------------------------------------------------
# Modo de cadena: "simulado" | "arbitrum"
# simulado  -> adaptador local, sin red, sin wallet. Es el default de la beta.
# arbitrum  -> usa ArbitrumChainAdapter (src/lib/chain/arbitrum-adapter.ts, ADR-030).
#              Ademas de esta variable hacen falta las direcciones de abajo: sin
#              ellas (o si el adaptador no se puede crear), la app sigue en
#              simulado y lo avisa por consola en vez de romperse.
NEXT_PUBLIC_CHAIN_MODE=simulado

# Red objetivo cuando NEXT_PUBLIC_CHAIN_MODE=arbitrum
# 421614 = Arbitrum Sepolia (testnet del hackathon) | 42161 = Arbitrum One
NEXT_PUBLIC_CHAIN_ID=421614

# Direcciones de contratos (las publica el equipo de contratos). Los tres son
# necesarios para que integracionCadenaLista() se active; ver docs/SIGUIENTES-PASOS-ARBITRUM.md.
NEXT_PUBLIC_REPORT_REGISTRY_ADDRESS=
NEXT_PUBLIC_TOKEN_REWARD_ADDRESS=
NEXT_PUBLIC_IDENTITY_ESCROW_ADDRESS=

# Bloque en el que quedo desplegado ReportRegistry. El indice compartido
# (src/lib/chain/eventos.ts, ADR-032) pagina getLogs desde aqui; sin este valor
# pagina desde el bloque 0, que en un RPC publico puede fallar o ser lento.
NEXT_PUBLIC_REPORT_REGISTRY_DEPLOY_BLOCK=0

# Wallet abstraction (Privy o Web3Auth). Vacio = pseudonimo local generado en el
# dispositivo Y, en modo arbitrum, firma con la wallet inyectada del navegador
# (MetaMask u otra) en vez de una wallet embebida (ver src/lib/chain/proveedor-inyectado.ts).
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Storage de evidencia --------------------------------------------------
# Vacio = adaptador simulado (data URL en el dispositivo).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# SECRETO. Ambito en Vercel: Production y Preview, marcada como Sensitive.
# NUNCA con prefijo NEXT_PUBLIC_: quedaria publicada en el bundle del navegador.
# Se lee solo desde codigo de servidor (una ruta /api/...), nunca desde src/lib/storage.
PINATA_JWT=

# --- Escalamiento a la autoridad -------------------------------------------
# SECRETO. Ambito en Vercel: SOLO Production — asi una rama de preview no puede
# avisar a un serenazgo real por accidente.
# Vacio = ticket simulado servido por /api/escalamiento.
# El aviso se aborta a los 4 s: si el canal no responde, el reporte igual queda
# publicado en la red vecinal.
ESCALATION_WEBHOOK_URL=

# --- Despliegue ------------------------------------------------------------
# Dominio publico, para metadataBase (tarjetas de Open Graph) y el sitemap.
# Vacio = se deduce de las variables de sistema de Vercel. Definirla solo si se
# estrena un dominio propio. Debe ser una URL absoluta con https y sin barra final.
NEXT_PUBLIC_SITE_URL=

# Valvula de escape del Content-Security-Policy. Vacio = CSP activa (recomendado).
# "report-only" = la politica solo reporta en consola y no bloquea nada. Usar solo
# si algo falla por CSP y no hay tiempo de diagnosticarlo antes de la demo.
CSP_MODO=

# --- Datos de demostracion (ADR-040) ----------------------------------------
# Apagados por defecto: la red arranca vacia y solo se llena con reportes reales.
# Poner en 1 SOLO para el ensayo del pitch (siembra 12 reportes en Lima y los
# contactos del circulo). Recordar el Redeploy: es NEXT_PUBLIC_*.
NEXT_PUBLIC_DATOS_DEMO=

# --- Canal del circulo de cuidado (ADR-046) ---------------------------------
# Buzon efimero de sobres CIFRADOS de extremo a extremo (el servidor no puede
# leer ninguna posicion). Sin estas dos, el canal usa memoria del proceso:
# completo en `next dev`, pero en Vercel cada peticion puede caer en otra
# instancia — para la prueba multi-telefono hay que provisionar un Redis
# gratuito en upstash.com y cargar ambas como Sensitive.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Grifo automatico de gas de testnet (ADR-051) ---------------------------
# SECRETO. Clave privada de una wallet con ETH de Arbitrum Sepolia (SOLO testnet,
# nunca una wallet con fondos reales). Al activar la firma embebida, /api/gas le
# deposita 0.0005 ETH de prueba a la wallet del vecino para que ancle sin pasos
# manuales. Sin esta variable el grifo responde 503 y la app sigue: los anclajes
# caen al comprobante simulado (ADR-049) hasta que alguien gotee a mano.
# Ambito en Vercel: Production y Preview, marcada Sensitive.
GAS_DRIP_PRIVATE_KEY=
