# ---------------------------------------------------------------------------
# Vecino Seguro — variables de entorno
# Copiar a .env.local para desarrollo. En Vercel: Project Settings > Environment Variables.
# La beta funciona SIN ninguna de estas variables (modo simulado por defecto).
# ---------------------------------------------------------------------------

# Modo de cadena: "simulado" | "arbitrum"
# simulado  -> adaptador local, sin red, sin wallet. Es el default de la beta.
# arbitrum  -> lo activa el equipo de contratos cuando ReportRegistry este desplegado.
NEXT_PUBLIC_CHAIN_MODE=simulado

# Red objetivo cuando NEXT_PUBLIC_CHAIN_MODE=arbitrum
# 421614 = Arbitrum Sepolia (testnet del hackathon) | 42161 = Arbitrum One
NEXT_PUBLIC_CHAIN_ID=421614

# Direcciones de contratos (las publica el equipo de contratos)
NEXT_PUBLIC_REPORT_REGISTRY_ADDRESS=
NEXT_PUBLIC_TOKEN_REWARD_ADDRESS=
NEXT_PUBLIC_IDENTITY_ESCROW_ADDRESS=

# Wallet abstraction (Privy o Web3Auth). Vacio = pseudonimo local generado en el dispositivo.
NEXT_PUBLIC_PRIVY_APP_ID=

# Storage de evidencia. Vacio = adaptador simulado (data URL en el dispositivo).
# NUNCA commitear el JWT real: va solo en Vercel/.env.local.
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Escalamiento a autoridad. Vacio = ticket simulado servido por /api/escalamiento.
ESCALATION_WEBHOOK_URL=
